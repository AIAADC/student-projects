# Copy this file to `.env.local` (gitignored) and fill in YOUR values.
# Nothing personal is committed to the repo; identity is injected locally.

# Owner identity — right-aligns your own chat bubbles in the 聊天 board.
# VITE_OWNER_WXID: a substring of your own wxid (account dir name), e.g. an alias.
# VITE_OWNER_NAME: your display name shown as "我 · <name>".
VITE_OWNER_WXID=
VITE_OWNER_NAME=

# Academic / identity label shown on the 学业 board and nav (e.g. "XX大学 XX专业 XX级").
# Used by the frontend (VITE_OWNER_IDENTITY) and the ingest scripts (OWNER_IDENTITY).
# Leave blank to render neutral labels with no school/identity info.
VITE_OWNER_IDENTITY=
OWNER_IDENTITY=

# Optional course/grades site to surface on the 学业 board (e.g. your school's GPA tool).
# Frontend reads VITE_COURSE_URL; scripts/fetchCourseData.ts reads COURSE_URL.
# Leave blank to hide the course card and skip course scraping entirely.
VITE_COURSE_URL=
COURSE_URL=

# Data-pipeline overrides (optional; only needed when RE-RUNNING the scripts).
# WECHAT_STORE: absolute path to your xwechat_files store if relocated off C:\.
# QQ_NUMBER: your QQ number (the numeric Tencent Files subdirectory).
WECHAT_STORE=
QQ_NUMBER=
