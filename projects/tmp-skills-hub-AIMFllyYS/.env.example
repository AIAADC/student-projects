# 复制为 .env 后填入真实值。.env 已被 git 忽略,绝不提交。

# 七牛云 AI 推理服务(https://api.qnaigc.com/v1),所有 AI 功能(翻译/分析/Agent)共用
QINIU_API_KEY=
# 可选:覆盖翻译/分析的缺省模型(deepseek/deepseek-v4-flash-20260731)
QINIU_MODEL=
# 可选:覆盖 API 基地址
QINIU_BASE_URL=

# 库存位置。留空则由 ~/.skills-hub/config.json 的指针决定（见 docs/specs/store-and-paths-v0.md）
SKILLS_HUB_HOME=
